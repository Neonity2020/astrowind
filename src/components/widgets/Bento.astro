---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Bento as Props } from '~/types';

// Asymmetric card grid ("bento"): items declare how many columns/rows they
// span and the grid packs them densely. Every row has the same height, so
// cards line up; an image, when present, fills the bottom of its card.

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 3,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const gridClass = columns === 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-2 lg:grid-cols-3';
const spanClass = (span?: number, rowSpan?: number) =>
  [span === 2 ? 'md:col-span-2' : span === 3 ? 'md:col-span-2 lg:col-span-3' : '', rowSpan === 2 ? 'md:row-span-2' : '']
    .filter(Boolean)
    .join(' ');
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  {
    items.length > 0 && (
      <div
        class:list={[
          'grid grid-cols-1 gap-4 md:gap-5 [grid-auto-flow:dense] md:auto-rows-[minmax(13rem,1fr)]',
          gridClass,
        ]}
      >
        {items.map(({ title: itemTitle, description, icon, image, span, rowSpan, callToAction, href }) => {
          const Card = href ? 'a' : 'div';
          return (
            <Card
              href={href}
              class:list={[
                'group relative flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 dark:border-slate-700 dark:bg-slate-900 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
                href ? 'transition hover:border-primary/40 hover:shadow-md' : '',
                spanClass(span, rowSpan),
              ]}
            >
              <div class="flex flex-col p-6">
                <div class="flex items-center gap-3">
                  {icon && (
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                      <Icon name={icon} class="h-6 w-6" />
                    </span>
                  )}
                  {itemTitle && <h3 class="text-lg font-bold leading-snug text-heading">{itemTitle}</h3>}
                </div>
                {description && (
                  <p class="mt-3 text-sm leading-relaxed text-muted text-pretty" set:html={description} />
                )}
                {callToAction && !href && (
                  <div class="mt-3">
                    <Button variant="link" {...callToAction} />
                  </div>
                )}
                {href && !callToAction && (
                  <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary">
                    Learn more
                    <Icon
                      name="tabler:arrow-right"
                      class="h-4 w-4 transition group-hover:translate-x-0.5 rtl:rotate-180"
                    />
                  </span>
                )}
              </div>
              {image && (
                <div class="relative mt-auto min-h-40 flex-1 overflow-hidden">
                  {typeof image === 'string' ? (
                    <Fragment set:html={image} />
                  ) : (
                    <Image
                      class="absolute inset-0 h-full w-full object-cover object-top"
                      widths={[400, 768]}
                      sizes="(max-width: 767px) 100vw, 640px"
                      width={640}
                      height={360}
                      layout="cover"
                      format="webp"
                      alt={itemTitle ?? ''}
                      {...image}
                    />
                  )}
                </div>
              )}
            </Card>
          );
        })}
      </div>
    )
  }
</WidgetWrapper>
